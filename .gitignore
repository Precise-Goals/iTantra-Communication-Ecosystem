# iTantra Android .gitignore

# ==================== Build output ====================
*.iml
.gradle
/local.properties
/.idea/
.idea/
.DS_Store
build/
**/build/
/build
app/build/
*.apk
*.aab
.device_id
/captures
.externalNativeBuild
.cxx
local.properties

# ==================== Kotlin/Java ====================
*.class
*.log
*.jar
*.war
*.ear
# The blanket *.jar rule above accidentally excluded this one — it's the actual root cause of
# gradlew.bat previously failing with "Could not find or load main class
# org.gradle.wrapper.GradleWrapperMain" for anyone who freshly clones this repo. Gradle's own
# convention is to always commit this specific jar (it's a small bootstrap stub, not a real
# dependency) so the wrapper works with zero setup.
!gradle/wrapper/gradle-wrapper.jar

# ==================== Android ====================
bin/
gen/
out/

# ==================== ONNX Models (too large for Git) ====================
# Models should be downloaded separately and placed in:
# app/src/main/assets/models/
app/src/main/assets/models/*.onnx
app/src/main/assets/models/tts/*.onnx
app/src/main/assets/models/*.ort
app/src/main/assets/models/*.bin

# ==================== Python ====================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
model-export/.env
model-export/venv/
model-export/__pycache__/

# ==================== Test data ====================
model-export/test_audio/
model-export/wer_report.json

# ==================== Signing keys ====================
*.jks
*.keystore
keystore.properties
