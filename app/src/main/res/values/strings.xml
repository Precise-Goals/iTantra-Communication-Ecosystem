    <!-- Permission rationale -->
    <string name="permission_microphone_rationale">iTantra needs microphone access to capture your speech for offline AI transcription (STT). No audio is sent to any server.</string>
    <string name="permission_location_rationale">Location access is required by Android to discover nearby Wi-Fi Direct devices. iTantra does not track your location.</string>
    <string name="permission_bluetooth_rationale">Bluetooth access is needed as a fallback communication channel when Wi-Fi Direct is unavailable.</string>
    <string name="permission_battery_rationale">Battery optimization must be disabled to keep the communication engine running in the background during active sessions.</string>

